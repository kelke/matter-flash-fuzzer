+# Datatypes the TLVWriter of chip needs to encode the requested TLV element type.
+TLV_TYPES: dict[str, Callable[[Any], Any]] = {
+    "int": int,
+    "uint": lambda v: uint(int(v)),
+    "bool": bool,
+    "float": float32,
+    "double": float,
+    "str": str,
+    "bytes": lambda v: b64decode(v) if isinstance(v, str) else bytes(v),
+    "null": lambda _v: None,
+}
+
+
+def flashfuzz_tlv_encoder(value: Any, value_type: str) -> Callable:
+    """ToTLV replacement to encode 'value' exactly as 'value_type'."""
+    if value_type not in TLV_TYPES:
+        raise ValueError(f"Unknown TLV type {value_type!r}, valid: {sorted(TLV_TYPES)}")
+    tlv_value = TLV_TYPES[value_type](value)
+
+    def encode(tag: int | None, _value: Any = None) -> bytes:
+        writer = TLVWriter()
+        writer.put(tag, tlv_value)
+        return bytes(writer.encoding)
+
+    return encode
+
+
+def flashfuzz_command_encoder(fields: list) -> Callable:
+    """ToTLV replacement for encoding a command exactly as 'fields'.
+
+    Format: '[tag, value, value_type]'.
+    """
+    for _tag, _value, value_type in fields:
+        if value_type not in TLV_TYPES:
+            raise ValueError(f"Unknown TLV type {value_type!r}, valid: {sorted(TLV_TYPES)}")
+    struct = {int(tag): TLV_TYPES[value_type](value) for tag, value, value_type in fields}
+
+    def encode() -> bytes:
+        writer = TLVWriter()
+        writer.put(None, struct)
+        return bytes(writer.encoding)
+
+    return encode
+
+
